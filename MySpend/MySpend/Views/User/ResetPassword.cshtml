@model MySpend.Models.ViewModels.ResetPasswordViewModel

<h2>Reset Password</h2>

<form method="post">
    <input type="hidden" asp-for="Token" />

    <label>New Password</label>
    <input asp-for="Password" type="password" required />

    <label>Confirm Password</label>
    <input asp-for="ConfirmPassword" type="password" required />

    <button type="submit">Change Password</button>
</form>


<div asp-validation-summary="ModelOnly" style="color:red"></div>
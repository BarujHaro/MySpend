@model MySpend.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}


<h2>Forgot Password</h2>

<form method="post">
    <label>Email</label>
    <input asp-for="Email" type="email" required />

    <button type="submit">Send reset link</button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <p style="color:red">@ViewData.ModelState.Values.First().Errors.First().ErrorMessage</p>
}
@using MySpend.Models.Entities
@{
    ViewData["Title"] = "Create / Edit Expense";
}

@model Expense

<div class="text-center">
    <h1 class="display-4">Create or edit expenses</h1>
    <a asp-controller="Expenses" asp-action="Expenses" class="btn btn-primary">Overview (Expenses)</a>
</div>



 <form asp-action="CreateEditExpense" asp-controller="Expenses" method="post">

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <input hidden asp-for="Id" />

    <label>Value $</label>
    <input class="form-control" type="number" placeholder="0" asp-for="Value" step="any" />

    <label>Category</label>
    <select asp-for="CategoryId" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
        <option value="">Select a category</option>
    </select>

    <label>Description</label>
    <input class="form-control" type="text" placeholder="Add a description" asp-for="Description" />

    <button class="btn btn-outline-primary mt-4" type="submit">submit</button>
</form>